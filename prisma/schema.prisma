generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Central contact/branding settings (singleton row)
model GlobalSettings {
  id            Int     @id @default(1)
  brandName     String  @default("PT Emeta Teknologi Indonesia")
  phoneDisplay  String  @default("+6280000005557")
  emailSupport  String  @default("info@emeta.co.id")
  officeAddress String  @default("Ruko WTC Matahari No. 921, Jl. Raya Serpong, Kota Tangerang Selatan, Banten, 15326")
  linkedinUrl   String  @default("https://linkedin.com")
  facebookUrl   String  @default("https://facebook.com")
  twitterUrl    String  @default("https://twitter.com")
  youtubeUrl    String  @default("https://youtube.com")
  foundedYear   String  @default("2024")
  heroTitle     String  @default("AI & Enterprise Software for Indonesian Enterprises")
  heroBody      String  @default("Bridging world-class AI and enterprise software with growing organizations and established enterprises across Indonesia.")
  aboutTitle    String  @default("PT Emeta Teknologi Indonesia")
  aboutBody     String  @default("Founded in (YEAR) to bridge the gap between world-class artificial intelligence (AI) and both growing organizations and established enterprises.")
  copyright     String  @default("© 2026 PT Emeta Teknologi Indonesia. All rights reserved.")
  // Section wording — Home
  heroCtaLabel  String  @default("Get in Touch")
  aboutStatsJson String @default("[{\"value\":\"3000+\",\"label\":\"Channel Partners\"},{\"value\":\"35\",\"label\":\"Strategic Locations\"},{\"value\":\"300\",\"label\":\"Cities in Indonesia\"}]")
  offeringsEyebrow String @default("Offerings")
  offeringsTitle   String @default("Product & Solutions")
  offeringsSubtitle String @default("Find out our latest news and updates")
  newsEyebrow   String  @default("News & Blogs")
  newsSubtitle  String  @default("Find out our latest news and updates")
  ctaTitle      String  @default("Ready to Transform Your Business?")
  ctaSubtitle   String  @default("Here For you")
  ctaButtonLabel String @default("Book a Demo")
  contactTitle  String  @default("Contact Us")
  // Products/Solutions toggle: when disabled, navbar link shows the Coming Soon page
  productsEnabled Boolean @default(true)
  comingSoonTitle String @default("Coming Soon...")
  comingSoonQuote String @default("\u201cA Beautiful Quote of the Century about waiting\u201d")
  heroImageUrl  String? // key of hero background image uploaded via CDN
  logoWhiteUrl  String?
  logoBlueUrl   String?
  contactMapUrl String?
  // Recipient of "Send a Message" inquiries (admin-defined)
  inquiryEmail  String  @default("info@emeta.co.id")
  updatedAt     DateTime @updatedAt
}

// Emails captured from the hero "Get in Touch" field — newsletter audience
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("website")
  createdAt DateTime @default(now())
}

// Company products (WrenAI, BarkingDog, AI Amaze, Phison)
model Product {
  id        String  @id @default(cuid())
  title     String
  slug      String  @unique
  tags      String  @default("") // comma-separated short tags e.g. "Data,AI,For Business"
  description String  // short plain-text excerpt — cards, meta description, JSON-LD
  content   String  @default("") // detail-page body, mini-markdown (see components/ArticleBody)
  iconUrl   String? // small card icon image key (CDN)
  imageUrl  String? // large detail-page image key (CDN); falls back to iconUrl
  learnMoreUrl String @default("")
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// News & blog posts
model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  tags      String   @default("") // comma-separated pillar tags e.g. "Product Update,AI & Analytics"
  excerpt   String
  content   String   @default("")
  imageUrl  String?
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aliases   BlogSlugAlias[]

  @@index([published, createdAt])
}

// Old blog URLs kept alive after a slug change — resolved with a 301 redirect
model BlogSlugAlias {
  id     Int      @id @default(autoincrement())
  slug   String   @unique
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}
