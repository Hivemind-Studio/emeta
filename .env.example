# Runtime
NODE_ENV=production

# PostgreSQL connection — dedicated DB for this app (emeta)
DATABASE_URL="postgresql://USER:***@HOST:PORT/emeta"

# Site URL for sitemap/robots/OG tags
SITE_URL="https://YOUR-DOMAIN.zeabur.app"

# Admin auth
AUTH_SECRET="change-me-32+-random-characters"
ADMIN_ALLOWED_EMAILS="admin@emeta.co.id"
ADMIN_PASSWORD="change-me"

# Asset storage — Cloudflare R2 (shared bucket, dedicated prefix for this project)
STORAGE_DRIVER=r2
CDN_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
CDN_ACCESS_KEY="<r2-access-key>"
CDN_SECRET_KEY="<r2-secret-key>"
CDN_BUCKET="denova"
CDN_REGION=apac
CDN_KEY_PREFIX="emeta"
NEXT_PUBLIC_CDN_KEY_PREFIX="emeta"
NEXT_PUBLIC_CDN_URL="https://cdn.denovamind.com"

# Contact / branding
CONTACT_PHONE="+6280000005557"
CONTACT_EMAIL="info@emeta.co.id"
CONTACT_ADDRESS="Ruko WTC Matahari No. 921, Jl. Raya Serpong, Kota Tangerang Selatan, Banten, 15326"
